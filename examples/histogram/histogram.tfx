; histogram.tfx -- 16-bin histogram with ATOM.ADD (bin = value & 15).
; Contended atomics are serialized by the LSU (2 cycles per lane).
;   arg0 = &in   arg1 = n   arg2 = &bins (16 words, zeroed by the host)
        s2r   r1, global_tid
        s2r   r2, num_lanes
        s2r   r3, num_warps
        mul   r4, r2, r3
        s2r   r10, arg0
        s2r   r11, arg1
        s2r   r12, arg2
        movi  r20, 1
        mov   r6, r1
loop:
        slt   r7, r6, r11
        bnone r7, done
        if    r7
          slli  r8, r6, 2
          add   r8, r8, r10
          lw    r9, 0(r8)
          andi  r9, r9, 15
          slli  r9, r9, 2
          add   r9, r9, r12
          atom.add r21, r9, r20   ; r21 = old count (order-dependent across warps)
        endif
        add   r6, r6, r4
        jmp   loop
done:
        exit
